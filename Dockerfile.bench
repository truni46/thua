# Dockerfile.bench — the benchmark harness (client side), separate from the vLLM server.
# It only needs to send HTTP to the model service, so it's a tiny CPU image (no GPU, no torch).
FROM python:3.12-slim
WORKDIR /harness
RUN pip install --no-cache-dir "httpx>=0.27" "pyyaml>=6.0" "datasets>=2.18"
COPY main.py ./
COPY src ./src
COPY configs ./configs
# trace-round1.jsonl is BTC data (secret) — mounted at runtime, never baked in.
ENTRYPOINT ["python", "main.py"]
